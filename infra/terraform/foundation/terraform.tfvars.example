# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.
allowed_account_id = "<ACCOUNT_ID>"  # REQUIRED — 12-digit account
data_bucket        = "<DATA_BUCKET>" # REQUIRED — S3 bucket the workload reads/writes (model, input, predictions)

# IAM: default creates Batch roles (job, instance, spot-fleet, SLR).
# To use existing roles instead (e.g. enterprise/sandbox with pre-provisioned IAM):
# create_iam                          = false
# existing_batch_job_role_arn         = "arn:aws:iam::<ACCOUNT_ID>:role/bridge-classifier-batch-job"
# existing_batch_instance_profile_arn = "arn:aws:iam::<ACCOUNT_ID>:instance-profile/bridge-classifier-batch-instance"
# existing_spot_fleet_role_arn        = "arn:aws:iam::<ACCOUNT_ID>:role/bridge-classifier-spot-fleet"
# existing_batch_service_role_arn     = "arn:aws:iam::<ACCOUNT_ID>:role/aws-service-role/batch.amazonaws.com/AWSServiceRoleForBatch"

# Networking: default creates a VPC + public subnets + SG.
# To use an existing VPC instead:
# create_networking          = false
# existing_subnet_ids        = ["subnet-...", "subnet-..."]
# existing_security_group_id = "sg-..."

# --- Ownership tags (set if required by your org) ---
# team = "your-team"
# poc  = "your-name"

# Optional overrides (defaults shown):
# project_name                     = "bridge-classifier"
# region                           = "us-east-1"
# vpc_cidr                         = "10.0.0.0/16"
# public_subnet_cidrs              = ["10.0.1.0/24", "10.0.2.0/24"]
# create_batch_service_linked_role = true   # set false if the account already has AWSServiceRoleForBatch
